# Copy to .env and fill in. Never commit .env.

# --- Zetaris (data layer) -------------------------------------------------
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Names of the two datasources `npm run zetaris:register` creates in Zetaris:
# the ERP database (orders, customers, parts) and the CRM database (account events).
ZETARIS_ERP_SOURCE=causa_erp
ZETARIS_CRM_SOURCE=causa_crm
# Password for the bundled Postgres that holds both sources (docker compose up -d).
CAUSA_DB_PASSWORD=change-me-locally

# --- Meterless Nightshift (primary AI provider) ---------------------------
# Both values come from Nightshift's Console. The NVIDIA key stays inside
# Nightshift (Setup > Providers), never in this file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Leave empty on the machine running Nightshift: Causa reads the token the runtime
# writes to its proxy-token file. Set it only when Nightshift runs elsewhere.
METERLESS_RUNTIME_TOKEN=
# Routing mode for quick steps (planning, critique) and for the final write-up.
# Pin a Nemotron-backed route here to make the NVIDIA evidence unambiguous.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b

# --- Runtime ----------------------------------------------------------------
# true: query the bundled TPC-H sample with SQLite and reason with the offline
# rule-based agents, so the project runs with no Zetaris, Nightshift or keys.
SAMPLE_MODE=false
PORT=8790
